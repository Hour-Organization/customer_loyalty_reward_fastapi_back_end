APP_NAME="KhmerShop API"
APP_DEBUG=true
# Public root of this server; uploaded file URLs use the request's own host when there is one.
APP_URL=http://localhost:8000

# SQLite needs no setup. For PostgreSQL (as docker compose runs it):
# DATABASE_URL=postgresql+psycopg://root:root@localhost:5432/customer_loyalty
DATABASE_URL=sqlite:///./database.sqlite

# Uploaded images, served at /storage.
STORAGE_DIR=./storage/public

# Minutes a token may sit unused before it stops working (7 days). 0 turns the check off.
TOKEN_IDLE_TIMEOUT=10080
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=*

# Seconds between runs of the overdue-reservation expiry ("90s", "5m" and "1h" work too). 0 turns it off.
EXPIRE_REDEMPTIONS_EVERY=300

# KHQR checkout. "" turns it off, "fake" settles it through POST /api/orders/{id}/payment/simulate
# (development only), "bakong" uses the Bakong Open API.
PAYMENT_PROVIDER=
# Minutes a customer has to pay a KHQR before the order is cancelled.
KHQR_PAYMENT_MINUTES=15
# If Bakong cannot be reached when a KHQR runs out, wait this long before expiring it unchecked.
KHQR_UNREACHABLE_GRACE_MINUTES=60
# Keep re-checking cancelled/expired KHQRs this long after their time limit; a late payment becomes REFUND_DUE.
KHQR_LATE_CHECK_MINUTES=30

# Bakong Open API. Get a token by registering an email (POST /v1/request_token, then /v1/verify); it lasts
# about 90 days and is renewed with /v1/renew_token. Check the setup with `python -m app.cli check-bakong`.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
# The shop's Bakong account, and the name (max 25 characters) and city (max 15) banking apps show.
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
# Only for a corporate merchant KHQR: the merchant id and acquiring bank your bank issued.
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
