APP_NAME="KhmerShop API"
APP_DEBUG=true
# Public root of this server; uploaded file URLs use the request's own host when there is one.
APP_URL=http://localhost:8000

# SQLite needs no setup. For PostgreSQL (as docker compose runs it):
# DATABASE_URL=postgresql+psycopg://root:root@localhost:5432/customer_loyalty
DATABASE_URL=sqlite:///./database.sqlite

# Uploaded images, served at /storage.
STORAGE_DIR=./storage/public

# Minutes a token may sit unused before it stops working (7 days). 0 turns the check off.
TOKEN_IDLE_TIMEOUT=10080
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=*

# Seconds between runs of the overdue-reservation expiry. 0 turns it off.
EXPIRE_REDEMPTIONS_EVERY=300
